{
  "name": "@sajn/bankid",
  "description": "Npm module to simplify integration with the Swedish Bank ID service",
  "keywords": [
    "node",
    "bankid",
    "authentication"
  ],
  "version": "4.0.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cert"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sajn-se/bankid.git"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "prepublishOnly": "pnpm build",
    "format": "prettier --write \"./**/*.{mjs,js,ts,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "author": "Sven Perkmann",
  "license": "MIT",
  "homepage": "https://github.com/sajn-se/bankid#readme",
  "bugs": {
    "url": "https://github.com/sajn-se/bankid/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@types/node": "^20.11.10",
    "prettier": "^3.2.4",
    "typescript": "5.x"
  },
  "peerDependencies": {
    "@types/node": ">=14 <25"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=14.18.0"
  }
}
